{
  "name": "architect",
  "version": "0.1.0",
  "description": "Draw your architecture. Make Claude follow it.",
  "license": "Apache-2.0",
  "author": "Abhiram Shaji",
  "type": "module",
  "main": "out/main/main.js",
  "bin": {
    "architect": "out/cli/main.js",
    "architect-mcp": "out/mcp/bridge.js",
    "architect-lsp": "out/lsp/server.js"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.mcp.config.ts && vite build --config vite.cli.config.ts && vite build --config vite.lsp.config.ts",
    "install:local": "npm run build && node scripts/build-local-target.mjs && node scripts/install-local.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "node scripts/shot.mjs",
    "shot:app": "node scripts/shot-app.mjs",
    "shots": "node scripts/shots.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.0.0",
    "chokidar": "^4.0.0",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.7",
    "typescript": "^5.6.0",
    "vscode-languageserver": "^10.1.1",
    "vscode-languageserver-textdocument": "^1.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright": "^1.63.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "dev.architect.app",
    "productName": "Architect",
    "files": [
      "out/**",
      "assets/**",
      "package.json",
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage"
    }
  }
}
